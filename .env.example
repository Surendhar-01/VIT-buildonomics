# ==========================================
# AI SkillProof Platform - Environment Config
# ==========================================

# ------------------------------------------
# Frontend Environment Variables (.env in frontend/)
# ------------------------------------------
VITE_API_URL=http://localhost:4000/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key

# ------------------------------------------
# Backend Environment Variables (.env in backend/)
# ------------------------------------------
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000

# Supabase Server-side (Privileged / Service Role)
# Note: Never expose the SERVICE_ROLE_KEY to the frontend!
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AI / LLM Configuration
# Optional: Provide Gemini API key or OpenAI-compatible endpoint key
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash
LLM_PROVIDER=gemini

# Digital Credential Cryptographic Signing (Ed25519)
# If left blank, the backend automatically generates and persists a dev Ed25519 keypair
CREDENTIAL_SIGNING_PRIVATE_KEY=
CREDENTIAL_SIGNING_PUBLIC_KEY=
CREDENTIAL_SIGNING_KEY_ID=skillproof-ed25519-v1

# Admin Platform Access (configured via .env only - NOT in Supabase)
# The platform admin bypasses Supabase Auth entirely
ADMIN_EMAIL=admin@skillproof.io
ADMIN_PASSWORD=Admin@SkillProof2026!

# Security & Sandbox Limits
CODE_EXECUTION_TIMEOUT_MS=5000
MAX_OUTPUT_BUFFER_BYTES=65536
